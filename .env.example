# Copy to .env and fill in what you use. .env is gitignored. Never commit real keys.

# Where local data lives (listings DB, photos, embeddings). Default: ./data
# SHOWING_DATA_DIR=./data

# --- Travel times (Phase 3). Optional: without a key the app uses a straight-line estimate. ---
# OpenRouteService free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Optional, opt-in only (billing account required; check Google's caching terms first).
GOOGLE_MAPS_API_KEY=

# --- Geocoding ---
# Census Geocoder needs no key. Nominatim (fallback) requires an identifying User-Agent.
NOMINATIM_USER_AGENT=showing-planner/0.1 (contact: you@example.com)

# --- Optional listing search (private use only; the public site asks each visitor for their own) ---
# https://www.rentcast.io/api  (free plan: 50 calls/month)
RENTCAST_API_KEY=

# --- Hosting (see docs/DEPLOY.md) ---
# SHOWING_HOSTED=true        # public site: isolated temporary workspace per visitor
# APP_PASSWORD=              # optional shared password
# TRUST_PROXY_HEADERS=true   # only behind a proxy you control (e.g. Cloudflare Tunnel)
